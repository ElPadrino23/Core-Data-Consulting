<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
<%- include('./../nav.ejs') %>

<main class="app-page">
    <div class="app-header">
        <div>
            <h1 class="app-title"><%= cliente.nombrerazonsocial %></h1>
            <p class="app-subtitle">RFC: <%= cliente.rfc %> &nbsp;|&nbsp; Tipo: <%= cliente.tipocliente %></p>
        </div>
        <div style="display:flex;gap:8px;">
            <a href="/clientes/editar?id=<%= cliente.idcliente %>" class="btn secondary">Editar</a>
            <a href="/clientes/lista" class="btn secondary">Volver</a>
        </div>
    </div>

    <!-- Pestanas -->
    <div class="tabs-lite" id="tabsNav">
        <button class="tab-lite active" onclick="mostrarTab('datos')">Datos generales</button>
        <button class="tab-lite" onclick="mostrarTab('documentos')">Documentos (<%= documentos.length %>)</button>
        <button class="tab-lite" onclick="mostrarTab('operaciones')">Operaciones (<%= operaciones.length %>)</button>
        <button class="tab-lite" onclick="mostrarTab('contratos')">Contratos (<%= contratos.length %>)</button>
        <button class="tab-lite" onclick="mostrarTab('alertas')">Alertas (<%= alertas.length %>)</button>
        <button class="tab-lite" onclick="mostrarTab('riesgo')">Perfil de riesgo</button>
    </div>

    <!-- Tab: Datos generales -->
    <section class="panel" id="tab-datos">
        <h3 style="margin:0 0 16px;color:var(--azul-oscuro);font-size:16px;">Datos generales</h3>
        <div class="form-grid">
            <div><label>Nombre / Razon social</label><div class="readonly-field"><%= cliente.nombrerazonsocial || '—' %></div></div>
            <div><label>RFC</label><div class="readonly-field"><%= cliente.rfc || '—' %></div></div>
            <div><label>CURP</label><div class="readonly-field"><%= cliente.curp || '—' %></div></div>
            <div><label>Tipo de persona</label><div class="readonly-field"><%= cliente.tipocliente || '—' %></div></div>
            <div><label>Correo</label><div class="readonly-field"><%= cliente.correoelectronico || '—' %></div></div>
            <div><label>Telefono</label><div class="readonly-field"><%= cliente.telefono || '—' %></div></div>
            <div><label>Nacionalidad / Pais</label><div class="readonly-field"><%= cliente.pais || 'Mexico' %></div></div>
            <div><label>Estatus PEP</label><div class="readonly-field"><%= cliente.espep ? 'Si — PEP' : 'No' %></div></div>
        </div>

        <h3 style="margin:20px 0 16px;color:var(--azul-oscuro);font-size:16px;">Domicilio</h3>
        <div class="form-grid">
            <div><label>Calle y numero</label><div class="readonly-field"><%= cliente.callenumero || '—' %></div></div>
            <div><label>Colonia</label><div class="readonly-field"><%= cliente.colonia || '—' %></div></div>
            <div><label>Ciudad</label><div class="readonly-field"><%= cliente.ciudad || '—' %></div></div>
            <div><label>Estado</label><div class="readonly-field"><%= cliente.estado || '—' %></div></div>
            <div><label>Codigo postal</label><div class="readonly-field"><%= cliente.codigopostal || '—' %></div></div>
            <div><label>Tipo de domicilio</label><div class="readonly-field">Fiscal</div></div>
        </div>
    </section>

    <!-- Tab: Documentos (RF-05) -->
    <section class="panel" id="tab-documentos" style="display:none;">
        <h3 style="margin:0 0 4px;color:var(--azul-oscuro);font-size:16px;">Documentos</h3>
        <p style="color:var(--muted);font-size:13px;margin:0 0 16px;">Revisa y valida los documentos de identidad del cliente. Los rechazos requieren motivo.</p>

        <!-- Mensaje de feedback tras una accion -->
        <div id="msg-docs" style="display:none;margin-bottom:14px;padding:10px 14px;border-radius:8px;font-size:13px;font-weight:500;"></div>

        <table class="striped responsive-table">
            <thead>
                <tr>
                    <th>Tipo de documento</th>
                    <th>Archivo</th>
                    <th>Estatus</th>
                    <th>Fecha validacion</th>
                    <th>Motivo rechazo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (documentos.length === 0) { %>
                    <tr><td colspan="6" style="color:var(--muted)">Sin documentos cargados para este cliente.</td></tr>
                <% } %>
                <% documentos.forEach(function(d) { %>
                    <%
                        var est = d.estadovalidacion || 'Pendiente';
                        var clsBadge = est === 'Validado' ? 'badge-ok' : (est === 'Rechazado' ? 'badge-danger' : 'badge-warn');
                        var fechaV = d.fechavalidacion ? new Date(d.fechavalidacion).toLocaleDateString('es-MX') : '—';
                    %>
                    <tr id="fila-<%= d.iddocumentocliente %>">
                        <td><strong><%= d.tipodocumento %></strong></td>
                        <td style="font-size:12px;color:var(--muted);"><%= d.nombrearchivo %></td>
                        <td>
                            <span id="badge-<%= d.iddocumentocliente %>" class="badge-soft <%= clsBadge %>"><%= est %></span>
                        </td>
                        <td id="fecha-<%= d.iddocumentocliente %>" style="font-size:13px;"><%= fechaV %></td>
                        <td id="motivo-<%= d.iddocumentocliente %>" style="font-size:12px;color:var(--rojo);">
                            <%= d.motivorechazo || '' %>
                        </td>
                        <td>
                            <% if (est !== 'Validado') { %>
                                <button
                                    class="btn-small btn"
                                    onclick="accionDocumento(<%= d.iddocumentocliente %>, 'Validado')"
                                    title="Aprobar documento">
                                    Validar
                                </button>
                            <% } %>
                            <% if (est !== 'Rechazado') { %>
                                &nbsp;
                                <button
                                    class="btn-small btn"
                                    style="background:var(--rojo);"
                                    onclick="pedirMotivoRechazo(<%= d.iddocumentocliente %>)"
                                    title="Rechazar documento">
                                    Rechazar
                                </button>
                            <% } %>
                            <% if (est === 'Validado' || est === 'Rechazado') { %>
                                <span style="font-size:11px;color:var(--muted);">Procesado</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>

    <!-- Modal para motivo de rechazo -->
    <div id="modal-rechazo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:999;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:12px;padding:28px 32px;width:420px;max-width:90vw;box-shadow:0 8px 32px rgba(0,0,0,0.18);">
            <h3 style="margin:0 0 8px;color:var(--azul-oscuro);font-size:16px;">Motivo del rechazo</h3>
            <p style="color:var(--muted);font-size:13px;margin:0 0 14px;">Indica por qué se rechaza este documento. Este motivo quedará registrado.</p>
            <textarea
                id="input-motivo"
                rows="3"
                style="width:100%;box-sizing:border-box;border:1px solid #dde3ec;border-radius:8px;padding:10px 12px;font-size:13px;resize:vertical;"
                placeholder="Ej: Documento ilegible, vencido, no coincide con los datos del cliente..."></textarea>
            <p id="error-motivo" style="color:var(--rojo);font-size:12px;margin:6px 0 0;display:none;">El motivo es obligatorio para rechazar un documento.</p>
            <div style="display:flex;gap:10px;margin-top:18px;justify-content:flex-end;">
                <button class="btn secondary" onclick="cerrarModal()">Cancelar</button>
                <button class="btn" style="background:var(--rojo);" onclick="confirmarRechazo()">Confirmar rechazo</button>
            </div>
        </div>
    </div>

    <!-- Tab: Operaciones -->
    <section class="panel" id="tab-operaciones" style="display:none;">
        <h3 style="margin:0 0 16px;color:var(--azul-oscuro);font-size:16px;">Operaciones</h3>
        <table class="striped responsive-table">
            <thead>
                <tr><th>ID</th><th>Producto</th><th>Tipo</th><th>Monto</th><th>Moneda</th><th>Fecha</th><th>Estatus</th></tr>
            </thead>
            <tbody>
                <% if (operaciones.length === 0) { %>
                    <tr><td colspan="7" style="color:var(--muted)">Sin operaciones registradas</td></tr>
                <% } %>
                <% operaciones.forEach(function(o) { %>
                    <tr>
                        <td><%= o.idoperacion %></td>
                        <td><%= o.producto || '—' %></td>
                        <td><%= o.tipooperacion || '—' %></td>
                        <td>$<%= Number(o.monto || 0).toLocaleString('es-MX') %></td>
                        <td><%= o.moneda || 'MXN' %></td>
                        <td><%= o.fecha || '—' %></td>
                        <td><span class="badge-soft badge-warn"><%= o.estatus || '—' %></span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>

    <!-- Tab: Contratos -->
    <section class="panel" id="tab-contratos" style="display:none;">
        <h3 style="margin:0 0 16px;color:var(--azul-oscuro);font-size:16px;">Contratos</h3>
        <table class="striped responsive-table">
            <thead>
                <tr><th>ID</th><th>Producto</th><th>Inicio</th><th>Vencimiento</th><th>Saldo</th><th>Estatus</th></tr>
            </thead>
            <tbody>
                <% if (contratos.length === 0) { %>
                    <tr><td colspan="6" style="color:var(--muted)">Sin contratos registrados</td></tr>
                <% } %>
                <% contratos.forEach(function(c) { %>
                    <tr>
                        <td><%= c.idcontrato %></td>
                        <td><%= c.producto || '—' %></td>
                        <td><%= c.fechainicio || '—' %></td>
                        <td><%= c.vencimiento || '—' %></td>
                        <td>$<%= Number(c.saldo || 0).toLocaleString('es-MX') %></td>
                        <td><span class="badge-soft badge-ok"><%= c.estatus || '—' %></span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>

    <!-- Tab: Alertas -->
    <section class="panel" id="tab-alertas" style="display:none;">
        <h3 style="margin:0 0 16px;color:var(--azul-oscuro);font-size:16px;">Alertas</h3>
        <table class="striped responsive-table">
            <thead>
                <tr><th>ID</th><th>Regla</th><th>Nivel</th><th>Estatus</th><th>Fecha</th></tr>
            </thead>
            <tbody>
                <% if (alertas.length === 0) { %>
                    <tr><td colspan="5" style="color:var(--muted)">Sin alertas generadas</td></tr>
                <% } %>
                <% alertas.forEach(function(a) { %>
                    <tr>
                        <td><%= a.idalerta %></td>
                        <td><%= a.regla || ('Op #' + a.idoperacion) %></td>
                        <td><span class="badge-soft <%= a.nivel === 'Alto' ? 'badge-danger' : 'badge-warn' %>"><%= a.nivel %></span></td>
                        <td><span class="badge-soft <%= a.estatus === 'Resuelta' ? 'badge-ok' : 'badge-warn' %>"><%= a.estatus %></span></td>
                        <td><%= a.fecha || '—' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>

    <!-- Tab: Perfil de riesgo -->
    <section class="panel" id="tab-riesgo" style="display:none;">
        <h3 style="margin:0 0 16px;color:var(--azul-oscuro);font-size:16px;">Perfil de riesgo</h3>
        <div class="form-grid">
            <div><label>Nivel de riesgo</label>
                <div class="readonly-field">
                    <% var nv = cliente.nivelriesgo || 'Bajo'; %>
                    <span class="badge-soft <%= nv === 'Alto' ? 'badge-danger' : (nv === 'Medio' ? 'badge-warn' : 'badge-ok') %>"><%= nv %></span>
                </div>
            </div>
            <div><label>Estatus PEP</label>
                <div class="readonly-field">
                    <% if (cliente.espep) { %><span class="badge-soft badge-danger">PEP</span><% } else { %>No<% } %>
                </div>
            </div>
            <div><label>Limite operativo autorizado</label>
                <div class="readonly-field">$<%= Number(cliente.limiteoperativoautorizado || 0).toLocaleString('es-MX') %> MXN</div>
            </div>
            <div><label>Estatus del cliente</label>
                <div class="readonly-field"><%= cliente.estatuscliente || '—' %></div>
            </div>
        </div>
        <% if (cliente.observaciones) { %>
            <div style="margin-top:16px;">
                <label style="display:block;margin-bottom:7px;color:var(--azul-oscuro);font-size:13px;font-weight:600;">Observaciones</label>
                <div class="readonly-field" style="min-height:60px;align-items:flex-start;padding-top:10px;"><%= cliente.observaciones %></div>
            </div>
        <% } %>
    </section>
</main>

<%- include('./../scripts.ejs') %>
<script>
    // ── Navegacion de pestanas ──
    function mostrarTab(nombre) {
        var tabs = ['datos', 'documentos', 'operaciones', 'contratos', 'alertas', 'riesgo'];
        tabs.forEach(function(t) {
            document.getElementById('tab-' + t).style.display = t === nombre ? '' : 'none';
        });
        document.querySelectorAll('.tab-lite').forEach(function(btn, i) {
            btn.classList.toggle('active', tabs[i] === nombre);
        });
    }

    // ── RF-05: Validacion de documentos ──
    var docIdPendiente = null;

    // Validar directamente (sin modal)
    function accionDocumento(idDocumento, estado) {
        enviarValidacion(idDocumento, estado, '');
    }

    // Abrir modal para capturar motivo de rechazo
    function pedirMotivoRechazo(idDocumento) {
        docIdPendiente = idDocumento;
        document.getElementById('input-motivo').value = '';
        document.getElementById('error-motivo').style.display = 'none';
        document.getElementById('modal-rechazo').style.display = 'flex';
    }

    function cerrarModal() {
        document.getElementById('modal-rechazo').style.display = 'none';
        docIdPendiente = null;
    }

    function confirmarRechazo() {
        var motivo = document.getElementById('input-motivo').value.trim();
        if (!motivo) {
            document.getElementById('error-motivo').style.display = 'block';
            return;
        }
        cerrarModal();
        enviarValidacion(docIdPendiente, 'Rechazado', motivo);
    }

    // Llamada fetch al endpoint RF-05
    async function enviarValidacion(idDocumento, estado, motivo) {
        try {
            var resp = await fetch('/clientes/validar-documento', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ idDocumento: idDocumento, estado: estado, motivo: motivo })
            });

            var result = await resp.json();

            if (result.exito) {
                // Actualizar badge en la tabla sin recargar
                var badge = document.getElementById('badge-' + idDocumento);
                if (badge) {
                    badge.textContent = estado;
                    badge.className   = 'badge-soft ' + (estado === 'Validado' ? 'badge-ok' : 'badge-danger');
                }

                // Actualizar fecha en la tabla
                var fechaEl = document.getElementById('fecha-' + idDocumento);
                if (fechaEl) fechaEl.textContent = new Date().toLocaleDateString('es-MX');

                // Actualizar motivo en la tabla
                var motivoEl = document.getElementById('motivo-' + idDocumento);
                if (motivoEl) motivoEl.textContent = motivo || '';

                mostrarMensaje('Documento ' + estado.toLowerCase() + ' correctamente.', 'ok');

                // Ocultar botones de la fila ya procesada
                setTimeout(function() { location.reload(); }, 1200);
            } else {
                mostrarMensaje('Error: ' + result.error, 'error');
            }
        } catch (err) {
            mostrarMensaje('Error de conexión: ' + err.message, 'error');
        }
    }

    function mostrarMensaje(texto, tipo) {
        var el = document.getElementById('msg-docs');
        el.textContent = texto;
        el.style.display = 'block';
        el.style.background  = tipo === 'ok' ? '#e9f7f1' : '#fff0f0';
        el.style.color       = tipo === 'ok' ? 'var(--verde)' : 'var(--rojo)';
        el.style.border      = '1px solid ' + (tipo === 'ok' ? '#c9eadc' : '#f0caca');
    }

    // Cerrar modal si se hace clic fuera
    document.getElementById('modal-rechazo').addEventListener('click', function(e) {
        if (e.target === this) cerrarModal();
    });
</script>
</body>
</html>
